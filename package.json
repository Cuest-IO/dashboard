{
  "name": "cuest-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.0.0 <=22.14.0"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.10.0",
    "@devexpress/dx-grid-core": "4.0.10",
    "@devexpress/dx-react-core": "4.0.10",
    "@devexpress/dx-react-grid": "4.0.10",
    "@devexpress/dx-react-grid-material-ui": "4.0.10",
    "@loadable/component": "5.16.4",
    "@mui/icons-material": "7.0.1",
    "@mui/lab": "7.0.0-beta.10",
    "@mui/material": "7.0.1",
    "@mui/system": "7.0.1",
    "@tanstack/react-query": "4.35.0",
    "autoprefixer": "10.4.21",
    "aws-amplify": "6.14.1",
    "axios": "1.8.4",
    "bootstrap": "5.3.5",
    "formik": "2.4.6",
    "i18next": "23.5.1",
    "jquery": "3.6.4",
    "material-react-table": "1.14.0",
    "mini-css-extract-plugin": "2.9.2",
    "moment": "2.30.1",
    "normalize.css": "8.0.1",
    "react": "18.3",
    "react-dom": "18.3.0",
    "react-i18next": "15.4.1",
    "react-router-dom": "6.30.0",
    "react-scripts": "5.0.1",
    "recharts": "2.15.2",
    "sass": "1.86.3",
    "twig": "1.17.1",
    "twig-html-loader": "0.1.9",
    "web-vitals": "4.2.4"
  },
  "scripts": {
    "build:local": "npm run gulp:local && npm run webpack:local && npm run react:build",
    "build:dev": "npm run webpack:dev && npm run gulp:dev && npm run react:dev",
    "build:prod": "npm run webpack:prod && npm run gulp:prod && npm run react:prod",
    "html:start": "npm-run-all --parallel html:server webpack:watch gulp:local",
    "html:server": "cross-env NODE_ENV=local webpack-dev-server --config config/webpack.config.local.js",
    "react:start": "react-scripts start",
    "react:build": "react-scripts build",
    "react:dev": "dotenv -e .env.development react-scripts build",
    "react:prod": "dotenv -e .env.production react-scripts build",
    "react:test": "react-scripts test",
    "react:eject": "react-scripts eject",
    "gulp:prod": "cross-env NODE_ENV=production gulp --gulpfile config/gulpfile.mjs",
    "gulp:dev": "cross-env NODE_ENV=development gulp --gulpfile config/gulpfile.mjs",
    "gulp:local": "cross-env NODE_ENV=local gulp --gulpfile config/gulpfile.mjs",
    "gulp:sprite": "cross-env NODE_ENV=local gulp sprite --gulpfile config/gulpfile.mjs",
    "webpack:prod": "cross-env NODE_ENV=production webpack --config config/webpack.config.prod.js",
    "webpack:dev": "cross-env NODE_ENV=development webpack --config config/webpack.config.dev.js",
    "webpack:local": "cross-env NODE_ENV=local webpack --config config/webpack.config.local.js",
    "webpack:watch": "cross-env NODE_ENV=local webpack --config config/webpack.config.local.js --watch --progress",
    "lint:js": "jest --projects \"./config/jest/jest.eslint.config.json\"",
    "lint:scss": "jest --projects \"./config/jest/jest.stylelint.config.json\"",
    "fix:js": "prettier-eslint --write $PWD/'./private/**/*.{js,ts,jsx,tsx,vue}' $PWD/'./private/*.{js,ts}'",
    "fix:scss": "prettier-stylelint --write \"./private/**/*.scss\"",
    "fix:json": "prettier --write \"./private/**/*.json\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "npm:@babel/plugin-transform-private-property-in-object@7.25.9",
    "@babel/plugin-transform-private-property-in-object": "7.25.9",
    "@types/node": "22.14.0",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@typescript-eslint/eslint-plugin": "5.58.0",
    "@typescript-eslint/parser": "5.58.0",
    "babel-loader": "10.0.0",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.2",
    "dart-sass": "1.25.0",
    "dotenv": "16.4.7",
    "dotenv-cli": "8.0.0",
    "eslint": "7.2.0",
    "eslint-config-airbnb": "18.2.1",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-webpack-plugin": "3.2.0",
    "glob": "11.0.1",
    "gulp": "5.0.0",
    "gulp-filter": "9.0.1",
    "gulp-flatten": "0.4.0",
    "gulp-imagemin": "7.1.0",
    "gulp-svg-sprite": "2.0.3",
    "gulp-tinypng-compress": "1.2.5",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.3",
    "image-minimizer-webpack-plugin": "4.1.3",
    "imagemin-gifsicle": "7.0.0",
    "imagemin-pngquant": "10.0.0",
    "imagemin-svgo": "11.0.1",
    "jest": "29.7.0",
    "jest-runner-eslint": "2.2.1",
    "jest-runner-stylelint": "2.3.7",
    "npm-run-all": "4.1.5",
    "postcss-loader": "8.1.1",
    "prettier-eslint-cli": "8.0.1",
    "prettier-stylelint": "0.4.2",
    "resolve-url-loader": "5.0.0",
    "sass-loader": "16.0.5",
    "stylelint": "16.18.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-prettier": "5.0.3",
    "terser-webpack-plugin": "5.3.14",
    "typescript": "4.9.5",
    "webpack": "5.98.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.1",
    "webpack-favicons": "1.5.4",
    "webpack-glob-entry": "2.1.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "6.0.1",
    "webpack-notifier": "1.15.0"
  }
}
