{
  "name": "cuest-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=16.0.0 <=22.14.0"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "5.3.0",
    "@devexpress/dx-react-core": "4.0.4",
    "@devexpress/dx-react-grid": "4.0.4",
    "@devexpress/dx-react-grid-material-ui": "4.0.4",
    "@loadable/component": "5.15.2",
    "@mui/icons-material": "5.11.16",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "5.15.7",
    "@mui/system": "5.11.16",
    "@tanstack/react-query": "4.35.0",
    "autoprefixer": "10.4.7",
    "aws-amplify": "5.3.10",
    "axios": "1.4.0",
    "bootstrap": "5.2.3",
    "formik": "2.4.5",
    "i18next": "23.5.1",
    "jquery": "3.6.4",
    "material-react-table": "1.14.0",
    "mini-css-extract-plugin": "2.6.1",
    "moment": "2.29.4",
    "normalize.css": "8.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "13.2.2",
    "react-router-dom": "6.10.0",
    "react-scripts": "5.0.1",
    "recharts": "2.8.0",
    "sass": "1.63.4",
    "twig": "1.15.4",
    "twig-html-loader": "0.1.9",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "build:local": "npm run gulp:local && npm run webpack:local && npm run react:build",
    "build:dev": "npm run webpack:dev && npm run gulp:dev && npm run react:dev",
    "build:prod": "npm run webpack:prod && npm run gulp:prod && npm run react:prod",
    "html:start": "npm-run-all --parallel html:server webpack:watch gulp:local",
    "html:server": "cross-env NODE_ENV=local webpack-dev-server --config config/webpack.config.local.js",
    "react:start": "react-scripts start",
    "react:build": "react-scripts build",
    "react:dev": "dotenv -e .env.development react-scripts build",
    "react:prod": "dotenv -e .env.production react-scripts build",
    "react:test": "react-scripts test",
    "react:eject": "react-scripts eject",
    "gulp:prod": "cross-env NODE_ENV=production gulp --gulpfile config/gulpfile.js",
    "gulp:dev": "cross-env NODE_ENV=development gulp --gulpfile config/gulpfile.js",
    "gulp:local": "cross-env NODE_ENV=local gulp --gulpfile config/gulpfile.js",
    "gulp:sprite": "cross-env NODE_ENV=local gulp sprite --gulpfile config/gulpfile.js",
    "webpack:prod": "cross-env NODE_ENV=production webpack --config config/webpack.config.prod.js",
    "webpack:dev": "cross-env NODE_ENV=development webpack --config config/webpack.config.dev.js",
    "webpack:local": "cross-env NODE_ENV=local webpack --config config/webpack.config.local.js",
    "webpack:watch": "cross-env NODE_ENV=local webpack --config config/webpack.config.local.js --watch --progress",
    "lint:js": "jest --projects \"./config/jest/jest.eslint.config.json\"",
    "lint:scss": "jest --projects \"./config/jest/jest.stylelint.config.json\"",
    "fix:js": "prettier-eslint --write $PWD/'./private/**/*.{js,ts,jsx,tsx,vue}' $PWD/'./private/*.{js,ts}'",
    "fix:scss": "prettier-stylelint --write \"./private/**/*.scss\"",
    "fix:json": "prettier --write \"./private/**/*.json\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "npm:@babel/plugin-transform-private-property-in-object@^7.25.9",
    "@babel/plugin-transform-private-property-in-object": "7.25.9",
    "@types/node": "17.0.45",
    "@types/react": "18.0.33",
    "@types/react-dom": "18.0.11",
    "@typescript-eslint/eslint-plugin": "5.58.0",
    "@typescript-eslint/parser": "5.58.0",
    "babel-loader": "8.2.5",
    "cross-env": "7.0.3",
    "css-loader": "6.7.1",
    "css-minimizer-webpack-plugin": "4.0.0",
    "dart-sass": "1.25.0",
    "dotenv": "16.0.1",
    "dotenv-cli": "7.4.1",
    "eslint": "7.2.0",
    "eslint-config-airbnb": "18.2.1",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-boundaries": "2.10.1",
    "eslint-plugin-import": "2.26.0",
    "eslint-webpack-plugin": "3.2.0",
    "glob": "9.2.0",
    "gulp": "4.0.2",
    "gulp-filter": "7.0.0",
    "gulp-flatten": "0.4.0",
    "gulp-imagemin": "7.1.0",
    "gulp-svg-sprite": "1.5.0",
    "gulp-tinypng-compress": "1.2.5",
    "html-loader": "4.1.0",
    "html-webpack-plugin": "5.5.0",
    "image-minimizer-webpack-plugin": "3.2.3",
    "imagemin-gifsicle": "7.0.0",
    "imagemin-pngquant": "9.0.2",
    "imagemin-svgo": "10.0.1",
    "jest": "28.1.2",
    "jest-runner-eslint": "1.0.1",
    "jest-runner-stylelint": "2.3.7",
    "npm-run-all": "4.1.5",
    "postcss-loader": "7.0.1",
    "prettier-eslint-cli": "6.0.1",
    "prettier-stylelint": "0.4.2",
    "resolve-url-loader": "5.0.0",
    "sass-loader": "13.0.2",
    "stylelint": "15.4.0",
    "stylelint-config-standard-scss": "8.0.0",
    "stylelint-prettier": "2.0.0",
    "terser-webpack-plugin": "5.3.3",
    "typescript": "4.9.5",
    "webpack": "5.98.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "4.9.3",
    "webpack-favicons": "1.3.8",
    "webpack-glob-entry": "2.1.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "5.8.0",
    "webpack-notifier": "1.15.0"
  }
}
